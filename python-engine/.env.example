# Engine + workers. Copy to .env for running outside Compose; Compose injects these from the root .env.
APP_ENV=local
# Role app_engine (docs/architecture/06_SECURITY_ARCHITECTURE.md §6)
DATABASE_URL=postgresql://app_engine:change-me-dev-only@postgres:5432/priceaction
REDIS_URL=redis://:change-me-dev-only@redis:6379/1
# Laravel -> engine bearer token (rotate with ENGINE_SERVICE_TOKEN_PREVIOUS)
ENGINE_SERVICE_TOKEN=change-me-dev-only
ENGINE_SERVICE_TOKEN_PREVIOUS=
ACTIVE_RULESET=pa-intraday@0.1.0
