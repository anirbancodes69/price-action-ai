{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``GET /internal/v1/provider-connections/{id}/access-token``.\n\nHeld in memory only, never logged or persisted.",
  "properties": {
    "access_token": {
      "format": "password",
      "title": "Access Token",
      "type": "string",
      "writeOnly": true
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    }
  },
  "required": [
    "access_token",
    "expires_at"
  ],
  "title": "ProviderAccessToken",
  "type": "object"
}
