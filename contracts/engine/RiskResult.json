{
  "$defs": {
    "AccountStateResult": {
      "additionalProperties": false,
      "description": "Account state as evaluated, with what remains (TRD-05 §8.1, §11).",
      "properties": {
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First failed account rule (TRD-05 §8), e.g. DAILY_LOSS_LIMIT_REACHED.",
          "title": "Blocked Reason"
        },
        "losing_streak": {
          "minimum": 0,
          "title": "Losing Streak",
          "type": "integer"
        },
        "open_risk": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Open Risk",
          "type": "string"
        },
        "realised_net_pnl_today": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Realised Net Pnl Today",
          "type": "string"
        },
        "remaining_daily_loss": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Remaining Daily Loss",
          "type": "string"
        }
      },
      "required": [
        "realised_net_pnl_today",
        "open_risk",
        "losing_streak",
        "remaining_daily_loss"
      ],
      "title": "AccountStateResult",
      "type": "object"
    },
    "RoundedLevels": {
      "additionalProperties": false,
      "description": "Entry, stop and target after tick-size rounding (TRD-01 §5).",
      "properties": {
        "entry": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Entry",
          "type": "string"
        },
        "stop": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Stop",
          "type": "string"
        },
        "target": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "entry",
        "stop",
        "target"
      ],
      "title": "RoundedLevels",
      "type": "object"
    },
    "SizingConstraints": {
      "additionalProperties": false,
      "description": "Quantity allowed by each constraint (TRD-05 §3).",
      "properties": {
        "qty_capital": {
          "title": "Qty Capital",
          "type": "integer"
        },
        "qty_daily_loss": {
          "title": "Qty Daily Loss",
          "type": "integer"
        },
        "qty_open_risk": {
          "title": "Qty Open Risk",
          "type": "integer"
        },
        "qty_position_cap": {
          "title": "Qty Position Cap",
          "type": "integer"
        },
        "qty_risk": {
          "title": "Qty Risk",
          "type": "integer"
        }
      },
      "required": [
        "qty_risk",
        "qty_capital",
        "qty_position_cap",
        "qty_open_risk",
        "qty_daily_loss"
      ],
      "title": "SizingConstraints",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Outcome of a sizing calculation. Rule violations are ``errors`` codes from TRD-05, not exceptions.",
  "properties": {
    "account_state": {
      "$ref": "#/$defs/AccountStateResult"
    },
    "actual_risk": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Actual Risk",
      "type": "string"
    },
    "actual_risk_pct": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Actual Risk Pct",
      "type": "string"
    },
    "binding_constraint": {
      "title": "Binding Constraint",
      "type": "string"
    },
    "constraints": {
      "$ref": "#/$defs/SizingConstraints"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "est_round_trip_costs": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Est Round Trip Costs",
      "type": "string"
    },
    "position_value": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Position Value",
      "type": "string"
    },
    "quantity": {
      "minimum": 0,
      "title": "Quantity",
      "type": "integer"
    },
    "risk_budget": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Risk Budget",
      "type": "string"
    },
    "risk_per_share": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Risk Per Share",
      "type": "string"
    },
    "rounding": {
      "$ref": "#/$defs/RoundedLevels"
    },
    "rr": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Rr",
      "type": "string"
    },
    "rr_after_costs": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Rr After Costs",
      "type": "string"
    },
    "ruleset_version": {
      "examples": [
        "pa-intraday 0.1.0"
      ],
      "title": "Ruleset Version",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "quantity",
    "risk_budget",
    "risk_per_share",
    "actual_risk",
    "actual_risk_pct",
    "position_value",
    "rr",
    "rr_after_costs",
    "est_round_trip_costs",
    "binding_constraint",
    "constraints",
    "account_state",
    "rounding",
    "warnings",
    "errors",
    "ruleset_version"
  ],
  "title": "RiskResult",
  "type": "object"
}
