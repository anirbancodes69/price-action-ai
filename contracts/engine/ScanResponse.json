        "binding_constraint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Binding Constraint"
        },
        "entry": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entry"
        },
        "htf_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Htf State"
        },
        "last_bar_end": {
          "format": "date-time",
          "title": "Last Bar End",
          "type": "string"
        },
        "paqs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Paqs"
        },
        "position_value": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Value"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sized with the account limits; null when no plan can be sized.",
          "title": "Quantity"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "risk_amount": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk Amount"
        },
        "rr": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rr"
        },
        "setup_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Setup Status"
        },
        "setup_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Setup Type"
        },
        "signal": {
          "description": "ENTRY_CONFIRMED, BUY_WATCH, NO_TRADE, INSUFFICIENT_HISTORY or INVALID_INPUT.",
