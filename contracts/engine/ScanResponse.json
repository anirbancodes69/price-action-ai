        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid Until"
        }
      },
      "required": [
        "symbol",
        "signal",
        "setup_type",
        "setup_status",
        "paqs",
        "entry",
        "stop",
        "target",
        "target_source",
        "rr",
        "quantity",
        "risk_amount",
        "position_value",
        "binding_constraint",
        "reasons",
        "signal_at",
        "valid_until",
        "last_bar_end",
        "stale",
        "htf_state"
