      "title": "Data Mode",
      "type": "string"
    },
    "notice": {
      "title": "Notice",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ScanRowModel"
      },
      "title": "Rows",
      "type": "array"
    },
    "ruleset_version": {
      "title": "Ruleset Version",
      "type": "string"
    }
  },
  "required": [
    "as_of_ts",
    "data_mode",
    "provider",
    "ruleset_version",
    "notice",
    "rows"
  ],
  "title": "ScanResponse",
  "type": "object"
}
