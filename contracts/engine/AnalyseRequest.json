{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Analyse one instrument at one 5m bar close (5m primary, 15m and daily context).\n\n``as_of_ts`` is the end of the last completed 5m bar to use; it defaults to the latest stored bar close.",
  "properties": {
    "as_of_ts": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of Ts"
    },
    "data_source_id": {
      "format": "uuid",
      "title": "Data Source Id",
      "type": "string"
    },
    "instrument_id": {
      "format": "uuid",
      "title": "Instrument Id",
      "type": "string"
    },
    "ruleset_version": {
      "examples": [
        "0.1.0"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Ruleset Version",
      "type": "string"
    }
  },
  "required": [
    "data_source_id",
    "instrument_id",
    "ruleset_version"
  ],
  "title": "AnalyseRequest",
  "type": "object"
}
