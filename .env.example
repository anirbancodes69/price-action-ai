# PriceAction AI — Docker Compose environment (docs/operations/02_ENVIRONMENT_CONFIGURATION.md).
# Do not edit secrets by hand: run ./scripts/setup-env.sh to create .env with random values.
# Placeholders below are intentionally invalid.

COMPOSE_PROJECT_NAME=priceaction
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_LEVEL=info
IMAGE_TAG=local

# Laravel application key (base64:...)
APP_KEY=

# PostgreSQL (superuser is used only by the init script)
POSTGRES_DB=priceaction
POSTGRES_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_BACKEND_PASSWORD=
DB_ENGINE_PASSWORD=

# Redis
REDIS_PASSWORD=

# Internal service tokens (ARC-06 §7)
ENGINE_SERVICE_TOKEN=
BACKEND_INTERNAL_TOKEN=

KITE_API_KEY=<your api key>
KITE_API_SECRET=<your api secret>
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/v1/integrations/zerodha/callback

# Intraday ingestion (personal mode, ENG-05 §12). Off unless INGEST_ENABLED=true.
INGEST_ENABLED=false
INGEST_PROVIDER=KITE
INGEST_DATA_SOURCE_ID=
INGEST_UNIVERSE_CODE=NIFTY50
KITE_TOKEN_FILE=.kite_token
