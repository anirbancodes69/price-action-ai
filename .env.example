# PriceAction AI — Docker Compose environment (docs/operations/02_ENVIRONMENT_CONFIGURATION.md).
# Do not edit secrets by hand: run ./scripts/setup-env.sh to create .env with random values.
# Placeholders below are intentionally invalid.

COMPOSE_PROJECT_NAME=priceaction
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_LEVEL=info
IMAGE_TAG=local

# Laravel application key (base64:...)
APP_KEY=

# PostgreSQL (superuser is used only by the init script)
POSTGRES_DB=priceaction
POSTGRES_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_BACKEND_PASSWORD=
DB_ENGINE_PASSWORD=

# Redis
REDIS_PASSWORD=

# Internal service tokens (ARC-06 §7)
ENGINE_SERVICE_TOKEN=
BACKEND_INTERNAL_TOKEN=
