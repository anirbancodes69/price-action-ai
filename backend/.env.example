# PriceAction AI — Laravel backend.
# Under Docker Compose these values are injected from the root .env (see docker-compose.yml);
# copy this file to backend/.env only when running artisan outside Compose.
# Inventory and rules: docs/operations/02_ENVIRONMENT_CONFIGURATION.md §2.3

APP_NAME="PriceAction AI"
APP_ENV=local
# Generate with: docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# JSON logs to stdout (docs/engineering/06_ERROR_HANDLING_AND_LOGGING.md)
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=debug

# Role app_backend (docs/architecture/06_SECURITY_ARCHITECTURE.md §6)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=priceaction
DB_USERNAME=app_backend
DB_PASSWORD=change-me-dev-only

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me-dev-only
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@priceaction.local"
MAIL_FROM_NAME="${APP_NAME}"

# Internal engine (Laravel -> engine bearer token)
ENGINE_URL=http://engine:8100
ENGINE_SERVICE_TOKEN=change-me-dev-only
ENGINE_TIMEOUT_SECONDS=2
